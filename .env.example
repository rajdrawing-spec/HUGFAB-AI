# ---------------------------------------------------------------------------
# HugFab environment
#
# Copy to .env.local and fill in what you have. `.env*` is git-ignored; this
# file is the only one committed, and it must never contain a real value.
#
# Nothing below is read unless it is uncommented and used by shipped code
# (PRD §36). Variables for phases that have not been built yet are listed as
# commented placeholders so their names are agreed in advance.
#
# Required in production, optional in development — a missing key in
# development degrades the feature; in production the server refuses to start
# (see src/lib/env.server.ts).
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------

# Absolute public URL of this deployment. Used for OAuth redirects, canonical
# URLs and metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# BCP-47 locale and ISO-4217 currency for the default market. India first;
# every price and date is formatted from these (PRD §73).
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# debug | info | warn | error
LOG_LEVEL=info

# --- Supabase ------------------------------------- required in production ---

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon (publishable) key. Safe in the browser: every query it can make is one
# RLS permits.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. BYPASSES RLS COMPLETELY.
# Server-only — never prefix with NEXT_PUBLIC_, never read outside
# src/lib/supabase/admin.ts, never commit. Rotate it if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting -------------------------------------------- optional ----

# Upstash Redis, used for distributed rate limits in production. Without these
# the limiter falls back to an in-memory window, which is correct for a single
# local process but meaningless across PM2 instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability -------------------------------------------- optional ----

# Both integrations no-op — and are not even downloaded by the browser — when
# their keys are absent.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Images ----------------------------------------------------- optional --

# Set to "true" once the domain is proxied through Cloudflare, to route
# next/image through /cdn-cgi/image resizing (src/lib/image-loader.ts).
# NEXT_PUBLIC_CLOUDFLARE_IMAGES=false

# ---------------------------------------------------------------------------
# NOT YET WIRED UP — placeholders only.
# Each is uncommented by the phase that actually uses it.
# ---------------------------------------------------------------------------

# --- AI providers (Phase 2) -------------------------------------------------
# The embedding model fixes the pgvector column dimension in migration 0001 and
# cannot be changed afterwards without re-embedding the whole catalogue.
# AI_PROVIDER=
# AI_API_KEY=
# AI_TEXT_MODEL=
# AI_VISION_MODEL=
# AI_EMBEDDING_MODEL=
# AI_EMBEDDING_DIMENSIONS=

# --- Affiliate networks (Phase 1) -------------------------------------------
# Only networks that are actually approved get uncommented. Until then the
# catalogue runs on clearly labelled MOCK DATA and no live price, coupon or
# availability is shown to anyone (PRD §60, §69).
# CUELINKS_API_KEY=
# ADMITAD_CLIENT_ID=
# ADMITAD_CLIENT_SECRET=
# IMPACT_ACCOUNT_SID=
# IMPACT_AUTH_TOKEN=
# VCOMMISSION_API_KEY=
# AMAZON_ASSOCIATES_TAG=
# AMAZON_PA_API_KEY=
# AMAZON_PA_API_SECRET=
# FLIPKART_AFFILIATE_ID=
# FLIPKART_AFFILIATE_TOKEN=

# --- Payments (Phase 5) -----------------------------------------------------
# Razorpay first, behind a provider interface so Stripe is a later addition
# rather than a rewrite (PRD §35).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Email (Phase 2, price alerts) ------------------------------------------
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=

# --- Build ------------------------------------------------------------------
# Set by CI from the commit SHA; surfaced by /api/health so the live commit is
# knowable without SSH. Do not set by hand.
# NEXT_PUBLIC_BUILD_SHA=

# Skips environment validation. For container image builds only — never set
# this on a running server.
# SKIP_ENV_VALIDATION=false
